# Copy to .env.<profile> (dev|test|uat|prod). Never commit real values (gitignored).
# ---- profile ----
IPC_PROFILE=uat
IPC_ORG_CODE=ipc-uat                 # ELEVATE organisation for this profile (research E16)
IPC_CODE_PREFIX=UAT-                 # prefix on ELEVATE entity/user codes created by this profile
IPC_TOPIC_SUFFIX=uat                 # ipc.<suffix>.* topics
IPC_CONSUMER_GROUP=ipc-workflow-uat
DEMO_MODE=true                       # demo clock allowed only in dev|test|uat (FR-038)
# ---- programme stores ----
MONGO_ROOT_USER=ipcroot
MONGO_ROOT_PASSWORD=change-me
MONGO_URL=mongodb://ipcroot:change-me@mongo:27017/?replicaSet=rs0&authSource=admin
MINIO_ROOT_USER=ipcminio
MINIO_ROOT_PASSWORD=change-me-too
EVIDENCE_BUCKET=ipc-evidence-uat
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://localhost   # path-style; caddy forwards /ipc-evidence-* to MinIO with Host preserved (SigV4)
WORKFLOW_DB_APP_USER=ipcworkflow      # restricted role: insert+find only on ledger (migration 0002)
WORKFLOW_DB_APP_PASSWORD=change-me-3
# ---- service wiring ----
WORKFLOW_URL=http://workflow:8080
EDGE_PRIVATE_URL=http://edge:8081
LOG_LEVEL=info
# ---- secrets used by programme services ----
SESSION_ENCRYPTION_KEY=              # 32-byte base64 (openssl rand -base64 32)
SERVICE_JWT_SECRET=                  # edge<->workflow private API
SCHEDULER_SHARED_SECRET=             # X-Scheduler-Secret header (research E12)
GRAFANA_ADMIN_PASSWORD=change-me
# ---- ELEVATE (real local stack; research E15) ----
ELEVATE_USER_URL=http://user:3001
ELEVATE_ENTITY_URL=http://entity_management:5001
ELEVATE_SAMIKSHA_URL=http://samiksha:4301
ELEVATE_PROJECT_URL=http://project:6001
ELEVATE_MENTORING_URL=http://mentoring:3000
ELEVATE_SCHEDULER_URL=http://scheduler:4000
ELEVATE_KAFKA_BROKERS=kafka:29092
ELEVATE_OBSERVATION_TOPIC=elevate_observations_dev
ELEVATE_PROJECT_TOPIC=sl-improvement-project-submission-dev
ELEVATE_NOTIFICATION_TOPIC=dev.notifications
ELEVATE_INTERNAL_ACCESS_TOKEN=
ELEVATE_ADMIN_TOKEN_ENTITY=
ELEVATE_ADMIN_TOKEN_SAMIKSHA=
ELEVATE_ADMIN_TOKEN_PROJECT=
ELEVATE_ADMIN_TOKEN_MENTORING=
ELEVATE_TENANT_CODE=default
ELEVATE_ORG_ID=                      # orgId of IPC_ORG_CODE; consumers ignore events from other orgs
MAILPIT_URL=http://mailpit:8025
# ---- demo users (seed) ----
DEMO_USER_PASSWORD=
