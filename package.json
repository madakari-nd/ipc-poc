{
  "name": "ipc-poc",
  "private": true,
  "version": "0.1.0",
  "description": "IPC programme POC: thin programme layer on ELEVATE (Spec Kit, MERN)",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "contracts:gen": "npm run gen --workspace @ipc/contracts",
    "contracts:lint": "npm run lint --workspace @ipc/contracts",
    "api:docs": "redocly build-docs packages/contracts/openapi.yaml -o docs/api/index.html",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "preflight": "tsx scripts/preflight.ts",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "ledger:verify": "tsx scripts/ledger-verify.ts",
    "dlq:replay": "tsx scripts/dlq-replay.ts",
    "up": "bash scripts/up.sh",
    "down": "bash scripts/down.sh",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:e2e": "NODE_OPTIONS=--experimental-transform-types playwright test",
    "prepare": "husky",
    "ledger:tamper-demo": "tsx scripts/ledger-tamper-demo.ts",
    "security:report": "tsx scripts/security-report.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.49.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "2.1.9"
  }
}
