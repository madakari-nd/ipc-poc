{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipc.localhost/contracts/events/ipc.task.evidence_submitted.schema.json",
  "title": "ipc.task.evidence_submitted",
  "description": "The owner submitted evidence meeting the task's evidence rule (FR-013). Published on topic ipc.<profile>.<name> keyed by wardId (or checklistCode for checklist events) through the workflow/adapters outbox, validated against this schema before publishing (FR-027). Contains no patient data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "programmeAt",
    "profile",
    "correlationId",
    "actor",
    "subject",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "ipc.task.evidence_submitted"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Server real time."
    },
    "programmeAt": {
      "type": "string",
      "format": "date-time",
      "description": "Programme (demo) clock time."
    },
    "profile": {
      "type": "string",
      "enum": [
        "dev",
        "test",
        "uat",
        "prod"
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "task"
        },
        "id": {
          "$ref": "#/$defs/objectId"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "planId",
        "wardId",
        "facilityId",
        "riskLevel",
        "fromState",
        "toState",
        "evidenceIds",
        "evidenceHashes"
      ],
      "properties": {
        "taskId": {
          "$ref": "#/$defs/objectId"
        },
        "planId": {
          "$ref": "#/$defs/objectId"
        },
        "wardId": {
          "$ref": "#/$defs/objectId"
        },
        "facilityId": {
          "$ref": "#/$defs/objectId"
        },
        "riskLevel": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "normal"
          ]
        },
        "fromState": {
          "type": "string",
          "enum": [
            "IN_PROGRESS",
            "CHANGES_REQUESTED"
          ]
        },
        "toState": {
          "const": "EVIDENCE_SUBMITTED"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectId"
          },
          "maxItems": 10
        },
        "evidenceHashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "maxItems": 10
        },
        "gpsMissingCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "objectId": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "userId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "ELEVATE user id."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "role"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "ELEVATE user id, or 'system' for consumers, sweeps and reconciliation."
        },
        "role": {
          "type": "string",
          "enum": [
            "STATE_ADMIN",
            "DISTRICT_QM",
            "IPC_OFFICER",
            "WARD_SUPERVISOR",
            "FRONTLINE",
            "MENTOR",
            "EXTERNAL_AUDITOR",
            "SYSTEM"
          ]
        }
      }
    }
  }
}
