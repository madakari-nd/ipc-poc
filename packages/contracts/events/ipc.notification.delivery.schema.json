{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipc.localhost/contracts/events/ipc.notification.delivery.schema.json",
  "title": "ipc.notification.delivery",
  "description": "Delivery status change of a notification (in-app, email via ELEVATE, SMS stand-in with consent and receipt) (FR-021). Template params are not carried. Published on topic ipc.<profile>.<name> keyed by wardId (or checklistCode for checklist events) through the workflow/adapters outbox, validated against this schema before publishing (FR-027). Contains no patient data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "programmeAt",
    "profile",
    "correlationId",
    "actor",
    "subject",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "ipc.notification.delivery"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Server real time."
    },
    "programmeAt": {
      "type": "string",
      "format": "date-time",
      "description": "Programme (demo) clock time."
    },
    "profile": {
      "type": "string",
      "enum": [
        "dev",
        "test",
        "uat",
        "prod"
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "notification"
        },
        "id": {
          "$ref": "#/$defs/objectId"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notificationId",
        "recipientUserId",
        "channel",
        "templateCode",
        "status",
        "consentGiven",
        "providerMessageId",
        "sentAt",
        "statusAt"
      ],
      "properties": {
        "notificationId": {
          "$ref": "#/$defs/objectId"
        },
        "recipientUserId": {
          "$ref": "#/$defs/userId"
        },
        "channel": {
          "type": "string",
          "enum": [
            "inapp",
            "email",
            "sms"
          ]
        },
        "templateCode": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "sent",
            "delivered",
            "failed",
            "read"
          ]
        },
        "consentGiven": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "SMS only; null for other channels."
        },
        "providerMessageId": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "relatedSubject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "task",
                "plan",
                "assessment",
                "escalation",
                "support_request"
              ]
            },
            "id": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "sentAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "statusAt": {
          "type": "string",
          "format": "date-time"
        },
        "failureCode": {
          "type": "string",
          "maxLength": 64
        }
      }
    }
  },
  "$defs": {
    "objectId": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "userId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "ELEVATE user id."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "role"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "ELEVATE user id, or 'system' for consumers, sweeps and reconciliation."
        },
        "role": {
          "type": "string",
          "enum": [
            "STATE_ADMIN",
            "DISTRICT_QM",
            "IPC_OFFICER",
            "WARD_SUPERVISOR",
            "FRONTLINE",
            "MENTOR",
            "EXTERNAL_AUDITOR",
            "SYSTEM"
          ]
        }
      }
    }
  }
}
