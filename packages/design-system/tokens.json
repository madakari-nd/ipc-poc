{
  "$description": "IPC design tokens (Constitution IX). Single source for the Tailwind preset and CSS variables. Every {fg, bg} pair must reach WCAG contrast >= 4.5:1 (tests/contrast.test.ts).",
  "color": {
    "base": {
      "surface": "#ffffff",
      "surface-muted": "#f3f4f6",
      "text": "#111827",
      "text-muted": "#4b5563",
      "border": "#6b7280",
      "border-subtle": "#d1d5db",
      "focus": "#1d4ed8",
      "overlay": "#111827"
    },
    "action": {
      "primary": { "fg": "#ffffff", "bg": "#1d4ed8", "hover": "#1e40af" },
      "secondary": { "fg": "#1e3a8a", "bg": "#eff6ff", "hover": "#dbeafe" },
      "danger": { "fg": "#ffffff", "bg": "#b91c1c", "hover": "#991b1b" },
      "ghost": { "fg": "#1f2937", "bg": "#ffffff", "hover": "#f3f4f6" }
    },
    "feedback": {
      "info": { "fg": "#1e3a8a", "bg": "#dbeafe" },
      "success": { "fg": "#14532d", "bg": "#dcfce7" },
      "warning": { "fg": "#78350f", "bg": "#fef3c7" },
      "error": { "fg": "#7f1d1d", "bg": "#fee2e2" },
      "offline": { "fg": "#1f2937", "bg": "#e5e7eb" }
    },
    "state": {
      "assigned": { "fg": "#1e3a8a", "bg": "#dbeafe" },
      "in-progress": { "fg": "#5b21b6", "bg": "#ede9fe" },
      "evidence-submitted": { "fg": "#155e75", "bg": "#cffafe" },
      "changes-requested": { "fg": "#9a3412", "bg": "#ffedd5" },
      "verified": { "fg": "#166534", "bg": "#dcfce7" },
      "pending-validation": { "fg": "#854d0e", "bg": "#fef9c3" },
      "closed": { "fg": "#374151", "bg": "#f3f4f6" }
    },
    "risk": {
      "critical": { "fg": "#ffffff", "bg": "#b91c1c" },
      "high": { "fg": "#7c2d12", "bg": "#fed7aa" },
      "normal": { "fg": "#1f2937", "bg": "#e5e7eb" }
    },
    "legend": {
      "reused": { "fg": "#065f46", "bg": "#d1fae5" },
      "customised": { "fg": "#6b21a8", "bg": "#f3e8ff" },
      "built-on-top": { "fg": "#92400e", "bg": "#fef3c7" }
    }
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "11": "44px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "size": {
    "touch": "44px"
  },
  "font": {
    "family": {
      "sans": "system-ui, \"Noto Sans\", \"Noto Sans Devanagari\", \"Noto Sans Kannada\", sans-serif",
      "mono": "ui-monospace, \"SFMono-Regular\", Menlo, monospace"
    },
    "size": {
      "xs": ["12px", "16px"],
      "sm": ["14px", "20px"],
      "base": ["16px", "24px"],
      "lg": ["18px", "28px"],
      "xl": ["20px", "28px"],
      "2xl": ["24px", "32px"],
      "3xl": ["30px", "36px"]
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "full": "9999px"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(17, 24, 39, 0.12)",
    "2": "0 4px 8px rgba(17, 24, 39, 0.14)",
    "3": "0 12px 24px rgba(17, 24, 39, 0.18)"
  }
}
