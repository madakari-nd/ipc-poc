{
  "name": "@ipc/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared design tokens, Tailwind preset and accessible components (Constitution IX)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
